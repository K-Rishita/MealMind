# Model providers (either or both). Models whose key is missing are skipped.
# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter key (free and paid models): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: comma-separated models to try in order (default: free OpenRouter models,
# then Gemini on the Google free tier, then paid Gemini via OpenRouter). Example:
# LLM_MODELS=openrouter:google/gemma-4-31b-it:free,google:gemini-2.5-flash

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Set to "rules" to plan without calling any model (no API usage)
PLANNER_MODE=
